      "parameters": {
        "jsCode": "const today = DateTime.now().setZone('Europe/Kyiv').toFormat('dd.MM.yyyy');\n\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => String(r['Дата'] || '').startsWith(today));\n\nconst clients = new Set(rows.map(r => r.chat_id)).size;\n\nconst dialogs = rows.map((r, i) =>\n  `${i + 1}. [${r['Дата']}] ${r['Клієнт']}\\nПитання: ${r['Питання клієнта']}\\nВідповідь бота: ${String(r['Відповідь бота'] || '').slice(0, 400)}`\n).join('\\n\\n');\n\nreturn [{ json: { today, total: rows.length, clients, dialogs } }];"
      },
